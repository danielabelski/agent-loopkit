# Etsy Logo Pack Pipeline — env template
#
# Copy to your deploy env (e.g., .env or your CI secrets store) and replace
# every __replace_me__ placeholder. NEVER commit the populated version.

# --- Stage 1: generate + Etsy draft ---
ETSY_PROFILE_DIR=/root/...hermes/secure/etsy/pw-visible-profile
ETSY_COPY_LISTING_ID=1604703223
ETSY_PRICE_USD=7.99
ETSY_QUANTITY=999
ETSY_CREATE_DRAFTS=1
ETSY_NOTIFY_DISCORD=0
ETSY_EDITOR_WAIT_ROUNDS=3

# --- Image provider ---
IMAGE_PROVIDER=openai-codex
IMAGE_MODEL=gpt-image-2-medium
IMAGE_API_KEY_FILE=/root/.hermes/secure/openai/api_key.txt

# --- Archive + state ---
OUTPUT_ARCHIVE_DIR=/root/etsy-logo-packs
THEME_CATALOG_FILE=/root/etsy-logo-packs/theme_catalog.json
WORKER_STATE_FILE=/root/etsy-logo-packs/state.json

# --- Stage 2: theme catalog refill ---
APPROVED_THRESHOLD=32
APPROVED_TARGET=96
MAX_CANDIDATES=120
MIN_SCORE_FOR_APPROVE=70
DUPLICATE_RISK_REJECT=high
TRADEMARK_RISK_REJECT=high

# --- Stage 3: Pinterest publish ---
PINTEREST_DRY_RUN=1
PINTEREST_PROFILE_DIR=/root/...nap/chromium/common/pinterest-profile-account2
PINTEREST_CDP_URL=http://127.0.0.1:9334
PIN_ABOUT_MAX_CHARS=100
PIN_TITLE_MAX_CHARS=100
SKIP_IF_RESULT_EXISTS=1

# --- Optional: Discord webhook (keep disabled by default) ---
DISCORD_WEBHOOK_FILE=/root/...ure/discord/etsy_logo_pack_webhook.json

# --- Loop tuning ---
PACKS_PER_BATCH=4
LOGOS_PER_PACK=4
MIN_APPROVED_THEMES=4   # Stage 1 fails closed below this

# --- noVNC recovery (only when Etsy throws DataDome/CAPTCHA) ---
VNC_DISPLAY=:77
VNC_PASSWORD_FILE=/root/...ure/etsy/vnc-passwd
NOVNC_PORT=6080