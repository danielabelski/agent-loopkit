# Stage 3 — Pinterest Publish
# Read by: pinterest_publish_worker.py
# Run via: scripts/pinterest_publish_cron_launcher.sh

# CRITICAL: keep this 1 unless you've explicitly authorized publishing.
# When 1, the worker exercises the full pin-creation flow but does NOT
# click the Publish button. The result file is written so you can
# diff against real pins later.
PINTEREST_DRY_RUN=1

# Dedicated Pinterest account profile. Do NOT reuse the Etsy profile
# here — each platform has its own to avoid DataDome cross-contamination.
PINTEREST_PROFILE_DIR=/root/snap/chromium/common/pinterest-profile-account2

# CDP endpoint where Playwright/Puppeteer connects to the persistent browser.
PINTEREST_CDP_URL=http://127.0.0.1:9334

# Pin content caps (per Pinterest limits).
# "Tell everyone what your Pin is about" field: max 100 chars.
PIN_ABOUT_MAX_CHARS=100
# Title field: max 100 chars.
PIN_TITLE_MAX_CHARS=100

# Idempotency guard: skip packs that already have a pinterest-publish-result.json.
SKIP_IF_RESULT_EXISTS=1