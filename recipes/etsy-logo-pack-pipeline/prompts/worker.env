# Stage 1 — Etsy Logo Pack Worker
# Read by: etsy_logo_pack_worker.py
# This is the deterministic input the worker reads. It is NOT an LLM prompt.

# --- Image generation ---
# Provider must match an entry in your image provider registry.
# Model must be one the provider supports and that your account has access to.
IMAGE_PROVIDER=openai-codex
IMAGE_MODEL=gpt-image-2-medium

# --- Inventory gates ---
# Number of packs generated per cron tick.
PACKS_PER_BATCH=4
# Number of individual logos per pack.
LOGOS_PER_PACK=4
# If fewer approved themes exist in the catalog, fail closed instead of
# recycling used themes or inventing new ones. Stage 2 must refill.
MIN_APPROVED_THEMES=4

# --- Etsy draft runner ---
# Path to the persistent browser profile that is logged into your Etsy shop.
# This profile is reused across runs — do NOT open it manually while the
# cron is running (Chromium profile locks prevent automation from starting).
ETSY_PROFILE_DIR=/root/.hermes/secure/etsy/pw-visible-profile

# ID of an INACTIVE listing you own. The runner copies category + digital
# delivery settings from this listing. The template must remain inactive;
# if Etsy promotes it to "active" the runner may overwrite instead of draft.
ETSY_COPY_LISTING_ID=1604703223

# Listing defaults — tune per your shop's positioning.
ETSY_PRICE_USD=7.99
ETSY_QUANTITY=999

# Fail-safe toggle. Set to 0 to make Stage 1 generate logos but skip
# the Etsy draft step (useful for theme-catalog review without risking
# new drafts while you're iterating on the worker).
ETSY_CREATE_DRAFTS=1

# How many rounds the runner waits for the Etsy editor to be ready.
# Increase to 5 if your network is slow; decrease to 1 if you want
# to fail fast.
ETSY_EDITOR_WAIT_ROUNDS=3

# Discord webhook notification (off by default; webhook delivery was
# the original flow and is no longer the primary delivery path).
ETSY_NOTIFY_DISCORD=0

# --- Optional proxy (for stable Etsy/DataDome behavior) ---
# ETSY_PROXY_SERVER=
# ETSY_PROXY_USERNAME=
# ETSY_PROXY_PASSWORD=