# Stage 2 — Theme Catalog Refill + Auto-Reviewer
# Read by: etsy_theme_catalog_manager.py
# Run via: scripts/etsy_theme_catalog_refill_launcher.sh

# When the approved-theme count drops below APPROVED_THRESHOLD, generate
# candidates to top it up. Stage 2 then auto-approves/rejects via
# deterministic score + dedup + trademark-risk checks.
APPROVED_THRESHOLD=32
APPROVED_TARGET=96
MAX_CANDIDATES=120

# Quality gates — candidates must clear all three to be approved.
# Score: 0-100 deterministic score from theme name, keywords, concept diversity.
MIN_SCORE_FOR_APPROVE=70

# Duplicate risk: low | medium | high. Anything 'high' is rejected.
DUPLICATE_RISK_REJECT=high

# Trademark risk: a separate check for names that overlap with known
# brands (Discord, Slack, Stripe, etc.). Set to 'high' to reject.
TRADEMARK_RISK_REJECT=high