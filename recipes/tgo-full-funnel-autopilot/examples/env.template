# TGO Full Funnel Autopilot — env template
#
# Copy this file to your deploy env (e.g., .env or your CI secrets store) and
# replace every __replace_me__ placeholder with the real value. NEVER commit
# the populated version to a repo.

# --- Facebook Page auth (read from disk at runtime) ---
TGO_PAGE_ID=__replace_me__
TGO_PAGE_ACCESS_TOKEN_FILE=/root/.hermes/secure/facebook/tgo_page_access_token.txt
TGO_USER_ACCESS_TOKEN_FILE=/root/.hermes/secure/facebook/tgo_user_access_token.txt

# --- Image generation (GPT Image / DALL-E / other) ---
TGO_IMAGE_API_KEY_FILE=/root/.hermes/secure/openai/api_key.txt
TGO_IMAGE_MODEL=gpt-image-2   # or your preferred model id

# --- Vercel deploy ---
NPM_CONFIG_CACHE=/root/.npm-vercel
VERCEL_AUTH_FILE=/root/.vercel/auth.json   # populated by `npx vercel login`

# --- Paths ---
TGO_AUTOMATION_ROOT=/root/techguruonline-automation
TGO_HISTORY_FILE=/root/techguruonline-automation/history/campaigns.jsonl
TGO_LANDINGS_DIR=/root/techguruonline-automation/landings
TGO_BRAND_LOGO=/root/techguruonline-automation/assets/tgo-logo.jpg

# --- Loop tuning ---
TGO_DAILY_FUNNEL_MAX_POSTS=3
TGO_PRICE_GUARD_MAX_COMMENTS=6
TGO_PRICE_GUARD_MAX_POSTS=12

# --- Comment guard offer ---
TGO_OFFER_PRICE_REGEX="(\$\s*350|350\s*(?:d[oó]lares|usd)?|Website\s+Starter|Starter\s+Webapp|costo\s+base)"
TGO_OFFER_REPLY_TEXT="Website Starter from <PRICE> ✅\nA starter site for local businesses who want a clear services page, direct contact, and a WhatsApp CTA wired up and ready to receive messages.\n\nIf you want a version for your business, message us on WhatsApp: https://wa.me/<YOUR_WHATSAPP_NUMBER>"

# --- Cadence / limits ---
TGO_LOOKBACK_DAYS=30   # dedup window for niches