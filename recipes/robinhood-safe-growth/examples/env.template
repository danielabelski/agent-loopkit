# Robinhood Safe Growth — env template
#
# Copy to your deploy env (e.g., .env or your CI secrets store) and replace
# every __replace_me__ placeholder. NEVER commit the populated version.

# --- MCP token file ---
RH_MCP_TOKEN_FILE=/root/...ure/robinhood_mcp_token.json
# --- Stage 1 (Entry Decision) ---
RH_SAFE_GROWTH_MODE=entry
RH_NOTIFY_TELEGRAM=1
RH_REDACT_ACCOUNTS=1

# --- Stage 2 (Afternoon Defense) ---
# RH_SAFE_GROWTH_MODE=defense
# RH_NOTIFY_TELEGRAM=1
# RH_REDACT_ACCOUNTS=1

# --- Stage 3 (Mission Control) ---
# RH_SAFE_GROWTH_MODE=mission
# RH_NOTIFY_TELEGRAM=0
# RH_REDACT_ACCOUNTS=1
# RH_MISSION_NOTES_FILE=/root/...hermes/state/robinhood_safe_growth_notes.json

# --- Universe + thresholds ---
# Modify to your tradable universe on the agentic account.
RH_UNIVERSE=SPY,QQQ,DIA,IWM,VOO,VTI,QQQM,SCHD,MSFT,AAPL,GOOGL,AMZN,NVDA
RH_SAFEZONE_THRESHOLD=0.55
RH_MAX_DAILY_TRADES=1
RH_RISK_TOLERANCE=conservative
RH_LANGUAGE=Spanish (es-PR)
RH_TIMEZONE=America/New_York

# --- Defense-specific overrides ---
RH_DEFENSE_MAX_LATE_ENTRIES=0
RH_DEFENSE_TRAILING_STOP_PCT=2.0
RH_DEFENSE_SAFEZONE_BOOST=0.05

# --- Mission Control parameters ---
RH_MISSION_LOOKBACK_DAYS=5
RH_MISSION_FAVOR_MIN_TRADES=2
RH_MISSION_PAUSE_MIN_LOSSES=3
RH_MISSION_NEVER_EXECUTES=1

# --- Loop tuning ---
MAX_CONSECUTIVE_ERRORS=4