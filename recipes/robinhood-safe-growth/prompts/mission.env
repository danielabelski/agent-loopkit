# Robinhood Safe Growth — Stage 3 Mission Control config
# Read by: robinhood_mcp_snapshot.py (mode=mission)
# Run via: scripts/robinhood_safe_growth_mission.sh

# Mission Control evaluation parameters
RH_MISSION_LOOKBACK_DAYS=5       # how many prior days to evaluate
RH_MISSION_FAVOR_MIN_TRADES=2    # promote symbol to "favor" if profitable in >=2 of last 5 sessions
RH_MISSION_PAUSE_MIN_LOSSES=3    # pause symbol if loss in >=3 of last 5 sessions

# Hard guard: Mission Control NEVER executes trades. Ever.
RH_MISSION_NEVER_EXECUTES=1

# Notes file location (the script appends to this; the operator can read it)
RH_MISSION_NOTES_FILE=/root/...hermes/state/robinhood_safe_growth_notes.json

# Read-only tool allowlist (same as snapshot, but excluding review_equity_order)
# Mission Control has no business proposing order reviews.
RH_ALLOWED_TOOLS=get_accounts,get_portfolio,get_equity_positions,get_equity_orders,get_equity_quotes,get_equity_tradability,get_historicals
RH_BANNED_TOOLS=place_equity_order,place_option_order,cancel_order,replace_order,add_to_watchlist,remove_from_watchlist,create_watchlist,update_watchlist,follow,unfollow,review_equity_order