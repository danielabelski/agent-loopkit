# Robinhood Safe Growth — Stage 2 defense config
# Read by: robinhood_mcp_snapshot.py (mode=defense)
# Run via: scripts/robinhood_safe_growth_defense.sh

# Defense-specific overrides on top of snapshot.env

# No new entries in the last 90 min of trading (default)
RH_DEFENSE_MAX_LATE_ENTRIES=0

# Recommendation: review positions trailing >2%
RH_DEFENSE_TRAILING_STOP_PCT=2.0

# Defense inherits the safezone threshold from snapshot.env
# but tightens it for the late-day window
RH_DEFENSE_SAFEZONE_BOOST=0.05   # add to RH_SAFEZONE_THRESHOLD for late-day conservatism

# Reuse the same tool allowlist
RH_ALLOWED_TOOLS=get_accounts,get_portfolio,get_equity_positions,get_equity_orders,get_equity_quotes,get_equity_tradability
RH_BANNED_TOOLS=place_equity_order,place_option_order,cancel_order,replace_order,add_to_watchlist,remove_from_watchlist,create_watchlist,update_watchlist,follow,unfollow