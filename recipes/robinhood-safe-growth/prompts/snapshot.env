# Robinhood Safe Growth — Stage 1 snapshot config
# Read by: robinhood_mcp_snapshot.py (mode=entry)
# Run via: scripts/robinhood_safe_growth_entry.sh

# Tradable universe. Conservative default: broad ETFs + quality megacaps.
# Modify to your tradable universe on the agentic account.
RH_UNIVERSE=SPY,QQQ,DIA,IWM,VOO,VTI,QQQM,SCHD,MSFT,AAPL,GOOGL,AMZN,NVDA

# Decision thresholds
RH_SAFEZONE_THRESHOLD=0.55     # Below this confidence → recommend CASH
RH_MAX_DAILY_TRADES=1          # Max recommended entries per day
RH_RISK_TOLERANCE=conservative # conservative | balanced | aggressive
RH_LANGUAGE=Spanish (es-PR)
RH_TIMEZONE=America/New_York

# MCP tool allowlist (read-only + review-only).
# Every "place_*" / "cancel_*" / "replace_*" / "add_*" / "remove_*" /
# "create_*" / "update_*" / "follow_*" / "unfollow_*" must be in the
# banned list below. The CI rejects any PR that removes these.
RH_ALLOWED_TOOLS=get_accounts,get_portfolio,get_equity_positions,get_equity_orders,get_equity_quotes,get_equity_tradability,get_historicals,review_equity_order
RH_BANNED_TOOLS=place_equity_order,place_option_order,cancel_order,replace_order,add_to_watchlist,remove_from_watchlist,create_watchlist,update_watchlist,follow,unfollow